{
  "workbench.colorTheme": "Gruvbox Light Hard",
  "diffEditor.ignoreTrimWhitespace": true,
  "editor.inlayHints.enabled": "on",
  "terminal.integrated.allowMnemonics": true,
  "terminal.integrated.defaultProfile.linux": "fish",
  "terminal.integrated.enableImages": true,
  "terminal.integrated.fontFamily": "FiraCode Nerd Font Mono",
  "terminal.integrated.fontLigatures.enabled": true,
  "editor.fontFamily": "\"FiraCode Nerd Font Mono\"",
  "redhat.telemetry.enabled": false,
  "workbench.preferredLightColorTheme": "Gruvbox Light Medium",
  "editor.minimap.autohide": "mouseover",
  "notebook.variablesView": true,
  "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
  "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.dockercompose",
  "[java]": {
    "editor.defaultFormatter": "redhat.java"
  },
  "editor.parameterHints.enabled": true,
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "inline"
  },
  "wakatime.align": "right",
  "editor.cursorSmoothCaretAnimation": "explicit",
  "diffEditor.codeLens": true,
  "editor.suggest.showStatusBar": true,
  "editor.fontLigatures": true,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.wrapTabs": false,
  "breadcrumbs.enabled": false,
  "workbench.editor.pinnedTabSizing": "normal",
  "window.density.editorTabHeight": "compact",
  "docker.extension.enableComposeLanguageServer": false,
  "editor.accessibilitySupport": "off",
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "window.autoDetectColorScheme": true,
  "java.inlayHints.parameterTypes.enabled": true,
  "editor.inlineSuggest.edits.showCollapsed": true,
  "java.debug.settings.showHex": true,
  "java.debug.settings.showQualifiedNames": false,
  "java.debug.settings.showStaticVariables": true,
  "java.dependency.showMembers": true,
  "java.completion.chain.enabled": true,
  "java.signatureHelp.description.enabled": true,
  "java.inlayHints.parameterNames.enabled": "all",
  "java.inlayHints.variableTypes.enabled": true,
  "terminal.integrated.gpuAcceleration": "on",
  "java.server.launchMode": "LightWeight",
  "java.codeGeneration.hashCodeEquals.useInstanceof": true,
  "java.codeGeneration.toString.codeStyle": "STRING_FORMAT",
  "java.debug.settings.showLogicalStructure": true,
  "workbench.preferredDarkColorTheme": "Gruvbox Dark Hard",
  "terminal.integrated.enableVisualBell": true,
  "terminal.integrated.fontWeight": "normal",
  "terminal.integrated.fontLigatures.featureSettings": "\"cv06\" on, \"cv14\" on, \"cv30\" on, \"ss03\" on, \"ss05\" on, \"ss06\" on, \"ss07\" on, \"ss08\" on",
  "files.autoSave": "afterDelay",
  "workbench.activityBar.compact": true,
  "workbench.panel.showLabels": false,
  "workbench.productIconTheme": "material-product-icons",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorWidth": 2,
  "workbench.iconTheme": "file-icons",
  "[mips]": {
    "editor.tabSize": 8
  },
  "window.commandCenter": false,
  "window.menuStyle": "custom",
  "workbench.layoutControl.enabled": false,
  "window.titleBarStyle": "native"
}

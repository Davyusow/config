// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "close_on_file_delete": true,
    "seed_search_query_from_cursor": "never",
    "message_editor": {
        "auto_replace_emoji_shortcode": true,
    },
    "colorize_brackets": true,
    "lsp_document_colors": "background",
    "always_treat_brackets_as_autoclosed": false,
    "allow_rewrap": "in_comments",
    "sticky_scroll": {},
    "autoscroll_on_clicks": false,
    "agent_ui_font_size": 15.0,
    "use_system_path_prompts": true,
    "window_decorations": "client",
    "show_edit_predictions": true,
    "features": {
        "edit_prediction_provider": "copilot",
    },
    "restore_on_startup": "launchpad",
    "telemetry": {
        "diagnostics": true,
        "metrics": true,
    },
    "session": {
        "restore_unsaved_buffers": true,
    },
    "drag_and_drop_selection": {
        "enabled": true,
    },
    "hover_popover_enabled": true,
    "hide_mouse": "never",
    "cursor_shape": "bar",
    "multi_cursor_modifier": "alt",
    "buffer_font_weight": 450.0,
    "ui_font_features": {
        //testes
        "cv01": true,
        "cv02": true,
        "cv15": true,
        "cv19": true,
        "cv23": true,
        "cv29": true,
        "cv31": true,
        "ss01": true,
        "ss03": true,
        "ss05": true,
    },
    "languages": {
        "YAML": {
            "tab_size": 2,
        },
        "C": {
            "tab_size": 2,
        },
        "TSX": {
            "tab_size": 2,
        },
        "Java": {
            "tasks": {
                "prefer_lsp": true,
            },
            "show_whitespaces": "selection",
        },
        "Go": {
            "formatter": "language_server",
            "hard_tabs": false,
        },
        "Shell Script": {
            "formatter": "language_server",
        },
    },
    "ui_font_weight": 400.0,
    "git": {
        "branch_picker": {
            "show_author_name": true,
        },
        "inline_blame": {
            "show_commit_summary": false,
        },
    },
    "agent": {
        "default_profile": "ask",
        "notify_when_agent_waiting": "all_screens",
        "default_model": {
            "provider": "copilot_chat",
            "model": "gpt-4.1",
        },
        "play_sound_when_agent_done": true,
        "button": true,
        "model_parameters": [],
    },
    "centered_layout": {
        "left_padding": 0.2,
        "right_padding": 0.2,
    },
    "use_smartcase_search": true,
    "prettier": {
        "allowed": true,
    },
    "completion_menu_scrollbar": "system",
    "show_wrap_guides": true,
    "scrollbar": {
        "axes": {
            "vertical": true,
            "horizontal": true,
        },
        "git_diff": true,
        "cursors": true,
        "show": "auto",
    },
    "gutter": {
        "min_line_number_digits": 0,
        "line_numbers": true,
        "runnables": true,
        "breakpoints": true,
        "folds": true,
    },
    "auto_signature_help": true,
    "show_signature_help_after_edits": true,
    "outline_panel": {
        "dock": "left",
    },
    "current_line_highlight": "all",
    "redact_private_values": false,
    "format_on_save": "off",
    "tab_size": 4,
    "pane_split_direction_horizontal": "down",
    "active_pane_modifiers": {
        "inactive_opacity": 0.7,
    },
    "zoomed_padding": true,
    "collaboration_panel": {
        "button": false,
    },
    "notification_panel": {
        "button": true,
    },
    "git_panel": {
        "collapse_untracked_diff": true,
        "sort_by_path": true,
        "status_style": "label_color",
        "dock": "left",
        "button": true,
    },
    "use_system_window_tabs": false,
    "bottom_dock_layout": "contained",
    "preview_tabs": {
        "enabled": false,
    },
    "tab_bar": {
        "show_tab_bar_buttons": true,
        "show_nav_history_buttons": false,
        "show": true,
    },
    "debugger": {
        "stepping_granularity": "line",
        "dock": "right",
        "button": false,
    },
    "search": {
        "button": true,
    },
    "image_viewer": {
        "unit": "decimal",
    },
    "completions": {
        "words": "enabled",
    },
    "show_whitespaces": "selection",
    "indent_guides": {
        "coloring": "disabled",
        "background_coloring": "indent_aware",
        "active_line_width": 1,
        "line_width": 1,
        "enabled": true,
    },
    "relative_line_numbers": "disabled",
    "buffer_line_height": "standard",
    "hard_tabs": false,
    "toolbar": {
        "agent_review": true,
        "selections_menu": true,
        "quick_actions": false,
        "breadcrumbs": false,
        "code_actions": true,
    },
    "diagnostics": {
        "button": true,
        "inline": {
            "enabled": true,
            "padding": 4,
        },
    },
    "tabs": {
        "show_diagnostics": "all",
        "close_position": "right",
        "show_close_button": "always",
        "activate_on_close": "neighbour",
        "file_icons": true,
        "git_status": true,
    },
    "title_bar": {
        "show_menus": false,
        "show_project_items": true,
        "show_sign_in": false,
        "show_user_picture": true,
        "show_onboarding_banner": true,
        "show_branch_name": true,
        "show_branch_icon": true,
    },
    "terminal": {
        "shell": {
            "with_arguments": {
                "program": "fish",
                "args": [],
                "title_override": "Terminal",
            },
        },
        "toolbar": {
            "breadcrumbs": false,
        },
        "blinking": "on",
        "cursor_shape": "bar",
        "dock": "bottom",
        "button": true,
    },
    "status_bar": {
        "cursor_position_button": true,
        "active_language_button": true,
    },
    "project_panel": {
        "hide_root": true,
        "indent_guides": {
            "show": "always",
        },
        "auto_fold_dirs": true,
        "hide_gitignore": false,
        "default_width": 240.0,
        "hide_hidden": false,
        "scrollbar": {
            "show": "auto",
        },
        "auto_reveal_entries": true,
        "starts_open": true,
        "indent_size": 12.0,
        "git_status": true,
        "folder_icons": true,
        "file_icons": true,
        "entry_spacing": "standard",
        "dock": "left",
        "button": true,
    },
    "disable_ai": true,
    "selection_highlight": true,
    "icon_theme": {
        "mode": "system",
        "light": "Colored Zed Icons Theme Light",
        "dark": "Monospace Icon Theme - Dark",
    },
    "minimap": {
        "max_width_columns": 80,
        "current_line_highlight": "all",
        "thumb_border": "full",
        "show": "auto",
        "thumb": "hover",
        "display_in": "active_editor",
    },
    "inlay_hints": {
        "show_background": true,
        "enabled": true,
    },
    "buffer_font_family": "FiraCode Nerd Font Mono",
    "ui_font_family": "FiraCode Nerd Font Mono",
    "base_keymap": "VSCode",
    "buffer_font_size": 14.0,
    "buffer_font_features": {
        //testes
        "cv01": true,
        "cv02": true,
        "cv15": true,
        "cv19": true,
        "cv23": true,
        "cv29": true,
        "cv31": true,
        "ss01": true,
        "ss03": true,
        "ss05": true,
    },
    "theme": {
        "mode": "dark",
        "light": "Gruvbox Light",
        "dark": "Gruvbox Material",
    },
    "theme_overrides": {
        "Gruvbox Material": {
            "syntax": {
                "hint": {
                    "font_style": "italic",
                    "color": "#d5c4a1", // texto claro
                    "background_color": "#3c3836",
                    "font_weight": 200, // fundo escuro
                },
            },
        },
    },
    "lsp": {
        "wakatime": {
            "initialization_options": {
                "api-key": "{wakatime}",
            },
        },
        "gopls": {
            "initialization_options": {
                "hints": {
                    "assignVariableTypes": true,
                    "compositeLiteralFields": true,
                    "compositeLiteralTypes": true,
                    "constantValues": true,
                    "functionTypeParameters": true,
                    "parameterNames": true,
                    "rangeVariableTypes": true,
                },
            },
        },
    },
}
